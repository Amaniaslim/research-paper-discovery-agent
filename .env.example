# Copy this file to .env and add your own keys.

# Optional: improves Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Reserved for later LLM summaries via SAIA/API Management.
# Recommended text model for this research agent:
SAIA_MODEL=mistral-large-3-675b-instruct-2512
SAIA_API_KEY=your_saia_api_key_here
SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
ENABLE_LLM_SUMMARIES=true

# Optional embedding model for a later semantic-memory upgrade:
SAIA_EMBEDDING_MODEL=multilingual-e5-large-instruct

# Embedding model used for PDF-RAG retrieval.
# - "local" (or empty) uses the offline deterministic embedding (no extra deps).
# - Any sentence-transformers model name enables better semantic embeddings,
#   e.g. sentence-transformers/all-MiniLM-L6-v2 (requires sentence-transformers
#   installed). Falls back safely to local if the model cannot be loaded.
EMBEDDING_MODEL=local

# OCR mode for scanned PDFs: disabled | tesseract | unlimited_ocr
OCR_MODE=disabled

# Optional advanced OCR backend (Baidu Unlimited-OCR).
# Option A: OpenAI-compatible HTTP endpoint (vLLM/SGLang), e.g. http://127.0.0.1:10000
UNLIMITED_OCR_BASE_URL=
UNLIMITED_OCR_MODEL=Unlimited-OCR
UNLIMITED_OCR_API_KEY=
# Option B: local CLI command. Use {image} as placeholder for the page image path.
# Example: UNLIMITED_OCR_PATH="python /opt/Unlimited-OCR/run.py --image {image}"
UNLIMITED_OCR_PATH=
